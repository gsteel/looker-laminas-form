{
    "name": "gsteel/looker-laminas-form",
    "description": "laminas-form integration for the \"looker\" template library",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "George Steel",
            "email": "george@net-glue.co.uk"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "infection/extension-installer": true
        },
        "platform": {
            "php": "8.3.99"
        }
    },
    "require": {
        "php": "~8.3 || ~8.4 || ~8.5",
        "azjezz/psl": "^4.2",
        "gsteel/looker": "^0",
        "laminas/laminas-escaper": "^2.17",
        "laminas/laminas-form": "^3.19.1",
        "psr/container": "^1.0 || ^2.0"
    },
    "require-dev": {
        "doctrine/coding-standard": "^14.0.0",
        "laminas/laminas-servicemanager": "^3.24.0",
        "php-standard-library/psalm-plugin": "^2.3",
        "phpunit/phpunit": "^12.5.4",
        "psalm/plugin-phpunit": "^0.19.5",
        "squizlabs/php_codesniffer": "^4.0.1",
        "vimeo/psalm": "^6.14.3"
    },
    "autoload": {
        "psr-4": {
            "Looker\\Form\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Looker\\Form\\Test\\": "test"
        }
    }
}
