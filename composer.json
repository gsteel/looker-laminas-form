{
    "name": "gsteel/looker-laminas-form",
    "description": "laminas-form integration for the \"looker\" template library",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "George Steel",
            "email": "george@net-glue.co.uk"
        }
    ],
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.99"
        }
    },
    "require": {
        "php": "~8.4 || ~8.5",
        "gsteel/looker": "~0.12.0",
        "laminas/laminas-escaper": "^2.17",
        "laminas/laminas-form": "^3.19.1",
        "php-standard-library/type": "^6.1",
        "psr/container": "^1.0 || ^2.0"
    },
    "require-dev": {
        "carthage-software/mago": "^1.45.0",
        "laminas/laminas-servicemanager": "^3.24.0",
        "phpunit/phpunit": "^13.2.5"
    },
    "autoload": {
        "psr-4": {
            "Looker\\Form\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Looker\\Form\\Test\\": "test"
        }
    }
}
